{
  "name": "content-hoarder",
  "module": "src/cli.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/cli.ts serve",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt src tests scripts",
    "format:check": "oxfmt --check src tests scripts",
    "check": "bun run typecheck && bun run lint && bun run lint:comments && bun run format:check && bun test",
    "lint:comments": "bun scripts/check-no-comments.ts"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.86.0",
    "@types/bun": "1.4.2",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "youtubei.js": "18.1.0",
    "zod": "4.6.5"
  }
}
