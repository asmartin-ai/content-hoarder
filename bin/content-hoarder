#!/bin/sh
set -eu

SCRIPT=$(readlink -f -- "$0")
ROOT=$(dirname "$(dirname "$SCRIPT")")
export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
PYTHON="$ROOT/.venv-linux/bin/python"
if [ ! -x "$PYTHON" ]; then
    printf '%s\n' 'content-hoarder Linux environment missing; see README.md Linux migration setup.' >&2
    exit 127
fi
cd "$ROOT"
exec "$PYTHON" -m content_hoarder "$@"
